# Copier ce fichier en .env et renseigner les valeurs.
# Seules les clés du ou des fournisseurs LLM réellement utilisés sont obligatoires.

# ── Fournisseur LLM ───────────────────────────────────────────────────────────
# "groq" (palier gratuit) ou "anthropic" (Claude, payant).
LLM_PROVIDER=anthropic

# Modèle du fournisseur global.
#   anthropic → claude-sonnet-4-6
#   groq      → qwen/qwen3-32b, llama-3.3-70b-versatile, openai/gpt-oss-20b
MODEL=claude-sonnet-4-6

# ── Clés des fournisseurs LLM ─────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
GROQ_API_KEY=

# ── Surcharge par agent (optionnel) ───────────────────────────────────────────
# Permet de mixer : Claude sur les agents exigeants en JSON, Groq ailleurs.
# Valeurs : "anthropic" ou "groq". Laisser vide pour utiliser LLM_PROVIDER.
# LLM_PROVIDER_MANDATE=
# LLM_PROVIDER_RESEARCH=
# LLM_PROVIDER_PORTFOLIO=
# LLM_PROVIDER_RISK=
# LLM_PROVIDER_EXECUTION=
# LLM_PROVIDER_CHAT=
# Modèles utilisés par les agents qui surchargent le fournisseur :
# MODEL_ANTHROPIC=claude-sonnet-4-6
# MODEL_GROQ=openai/gpt-oss-20b

# ── Sources de données (optionnelles, le code retombe sur yfinance) ──────────
# Financial Modeling Prep — historiques 5 ans, ratios, consensus de prix cibles.
# Palier gratuit : 250 appels/jour. Vide → tools/fmp_data.py renvoie statut SKIP.
FMP_API_KEY=

# Tavily — actualités, vues d'analystes, composition d'un indice.
# Palier gratuit : 1 000 recherches/mois. Vide → tools/web_search.py renvoie SKIP.
TAVILY_API_KEY=

# ── Divers ────────────────────────────────────────────────────────────────────
# Délai maximum d'un appel LLM, en secondes (défaut 120).
# LLM_TIMEOUT=120
