---
config:
  theme: base
  themeVariables:
    fontFamily: "Segoe UI, Helvetica Neue, Arial, sans-serif"
    fontSize: 15px
    lineColor: "#8496AC"
    primaryColor: "#FFFFFF"
    primaryTextColor: "#101720"
    primaryBorderColor: "#8496AC"
    clusterBkg: "#FAFBFD"
    clusterBorder: "#D3DBE6"
    edgeLabelBackground: "#FFFFFF"
  flowchart:
    curve: basis
    padding: 16
    nodeSpacing: 42
    rankSpacing: 50
    wrappingWidth: 420
---
flowchart TB

  MANDAT("<b>ENTRÉE</b> — mandat, brief de recherche,<br/>tickers éventuellement fournis")

  subgraph UNIV["&nbsp;&nbsp;PHASE 1 — CONSTRUIRE L'UNIVERS : quatre chemins essayés dans l'ordre a, b, c, d — chacun en repli du précédent&nbsp;&nbsp;"]
    direction TB
    U1("<b>a</b> · tickers fournis explicitement par le gérant")
    U2("<b>b</b> · génération depuis le brief conversationnel")
    U3("<b>c</b> · reconstitution du benchmark<br/>recherche web → extraction des tickers par le modèle<br/>→ validation un par un → screening")
    U4("<b>d</b> · liste par défaut, environ 80 grandes capitalisations")
    TRI("<b>Tri déterministe par bêta</b><br/>croissant pour un profil défensif, décroissant sinon,<br/>puis troncature à environ 1,5 fois le nombre de positions visé")
    U1 --> TRI
    U2 --> TRI
    U3 --> TRI
    U4 --> TRI
  end

  subgraph ANA["&nbsp;&nbsp;PHASE 2 — ANALYSER CHAQUE TITRE : 5 titres en parallèle&nbsp;&nbsp;"]
    direction TB
    F("<b>Collecte parallèle</b> — 6 requêtes simultanées par titre<br/>yfinance · Financial Modeling Prep · SEC EDGAR · Tavily<br/><i>chaque source renvoie un statut d'erreur plutôt que de lever :<br/>un titre s'analyse même avec la moitié des sources en panne</i>")
    E("<b>Complément déterministe</b><br/>nom, secteur et pays repris des données de marché")
    L("<b>APPEL AU MODÈLE</b> — un par titre<br/>thèse, valorisation, risques, catalyseurs,<br/>score de conviction, poids suggéré")
    F --> E --> L --> C
    C("<b>Casts tolérants et bornage</b><br/>« 75/100 » devient 75, le poids est ramené dans [0 ; 0,10]<br/><i>sans cela, le titre entier basculait en analyse dégradée</i>")
  end

  OUT("<b>SORTIE</b><br/>research[] — une fiche par titre<br/>un rapport HTML autonome par titre")

  MANDAT --> UNIV
  UNIV -->|"univers ordonné"| ANA
  ANA --> OUT

  class MANDAT,OUT io;
  class U1,U2,U3,U4,TRI,F,E,C calc;
  class L juge;

  classDef juge fill:#FCF3E4,stroke:#B8801F,stroke-width:2px,color:#4A3208,rx:8,ry:8;
  classDef calc fill:#DAEEE8,stroke:#0D6B59,stroke-width:2px,color:#0A362E,rx:8,ry:8;
  classDef io fill:#EBF1FA,stroke:#3A5A8C,stroke-width:1.8px,color:#16253C,rx:8,ry:8;
  classDef stop fill:#FBE4E1,stroke:#9C2A22,stroke-width:2px,color:#4A110D,rx:8,ry:8;
  classDef data fill:#FFFFFF,stroke:#8496AC,stroke-width:1.4px,color:#101720,rx:8,ry:8;

  linkStyle default stroke-width:1.6px;
