---
config:
  theme: base
  themeVariables:
    fontFamily: "Segoe UI, Helvetica Neue, Arial, sans-serif"
    fontSize: 15px
    lineColor: "#8496AC"
    primaryColor: "#FFFFFF"
    primaryTextColor: "#101720"
    primaryBorderColor: "#8496AC"
    clusterBkg: "#FAFBFD"
    clusterBorder: "#D3DBE6"
    edgeLabelBackground: "#FFFFFF"
  flowchart:
    curve: basis
    padding: 16
    nodeSpacing: 42
    rankSpacing: 50
    wrappingWidth: 420
---
flowchart TB

  IN("<b>ENTRÉE</b> - choix du gérant<br/>stratégie · capital · benchmark · horizon<br/>profil de risque · bêta min et max · priorité")

  subgraph AVANT["&nbsp;&nbsp;CE QUE PYTHON DÉCIDE AVANT L'APPEL&nbsp;&nbsp;"]
    direction TB
    P1("<b>Réconciliation profil ↔ bêta</b><br/>un bêta minimum de 1,5 avec un profil « conservateur »<br/>fait basculer le profil effectif en « agressif »<br/><i>le chiffre saisi l'emporte sur la case cochée</i>")
    P2("<b>Table des cinq enveloppes de risque</b><br/>volatilité, drawdown, tracking error, bornes de bêta<br/>et concentration maximale, fixés par profil")
    P3("<b>Classement des onze secteurs GICS</b><br/>primaire, secondaire ou exclu selon la compatibilité<br/>de leur bêta médian avec le profil retenu")
  end

  LLM("<b>APPEL AU MODÈLE</b> - un seul<br/>reçoit un gabarit déjà largement pré-rempli<br/>complète l'univers, les exclusions ESG, la formulation<br/>et signale les incohérences du mandat")

  subgraph APRES["&nbsp;&nbsp;CE QUE PYTHON RÉÉCRIT APRÈS L'APPEL&nbsp;&nbsp;"]
    direction TB
    R1("<b>Capital et profil réimposés</b><br/>le modèle arrondit parfois 100 000 000 en 100 000 :<br/>ces deux champs viennent du formulaire, pas de lui")
    R2("<b>Contraintes non conformes écartées</b><br/>les clés transversales scalaires glissées par le modèle<br/>sont retirées avant la validation Pydantic")
  end

  OUT("<b>SORTIE</b> - MandateOutput<br/>lu par les quatre agents suivants")

  IN --> AVANT
  AVANT -->|"gabarit + directive sectorielle"| LLM
  LLM -->|"JSON du mandat"| APRES
  APRES --> OUT

  class IN,OUT io;
  class P1,P2,P3,R1,R2 calc;
  class LLM juge;

  classDef juge fill:#FCF3E4,stroke:#B8801F,stroke-width:2px,color:#4A3208,rx:8,ry:8;
  classDef calc fill:#DAEEE8,stroke:#0D6B59,stroke-width:2px,color:#0A362E,rx:8,ry:8;
  classDef io fill:#EBF1FA,stroke:#3A5A8C,stroke-width:1.8px,color:#16253C,rx:8,ry:8;
  classDef stop fill:#FBE4E1,stroke:#9C2A22,stroke-width:2px,color:#4A110D,rx:8,ry:8;
  classDef data fill:#FFFFFF,stroke:#8496AC,stroke-width:1.4px,color:#101720,rx:8,ry:8;

  linkStyle default stroke-width:1.6px;
