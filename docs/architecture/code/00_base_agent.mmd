  P("<b>_parse_json(text)</b><br/>1. bloc ```json  2. bloc ```  3. premier { … dernier }<br/>si JSONDecodeError → <b>_repair_truncated_json()</b><br/>automate à pile : referme chaînes, objets, tableaux")
  M("<b>XxxOutput(**data)</b><br/>validation Pydantic<br/>ValidationError → repli de l'agent")
