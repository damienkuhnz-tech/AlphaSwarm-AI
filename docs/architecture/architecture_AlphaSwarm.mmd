---
config:
  theme: base
  themeVariables:
    fontFamily: "Segoe UI, Helvetica Neue, Arial, sans-serif"
    fontSize: 15px
    lineColor: "#8496AC"
    primaryColor: "#FFFFFF"
    primaryTextColor: "#101720"
    primaryBorderColor: "#8496AC"
    clusterBkg: "#FAFBFD"
    clusterBorder: "#D3DBE6"
    edgeLabelBackground: "#FFFFFF"
    tertiaryColor: "#FFFFFF"
  flowchart:
    curve: basis
    padding: 16
    nodeSpacing: 45
    rankSpacing: 52
    wrappingWidth: 420
    useMaxWidth: true
---
flowchart TB

  GERANT("<b>GÉRANT DE PORTEFEUILLE</b><br/>stratégie · capital · benchmark<br/>horizon · profil de risque")
  WEB("<b>INTERFACE ET API</b><br/>formulaire de mandat<br/>suivi du run en direct<br/><i>api.py - port 5001</i>")

  subgraph PIPE["&nbsp;&nbsp;LES CINQ AGENTS - pipeline séquentiel&nbsp;&nbsp;"]
    direction TB
    A1("<b>1 · MANDAT</b><br/>contraintes chiffrées")
    A2("<b>2 · RECHERCHE</b><br/>univers analysé et noté")
    A3("<b>3 · PORTEFEUILLE</b><br/>sélection et pondération")
    A4("<b>4 · RISQUE</b><br/>validation et verdict")
    A5("<b>5 · EXÉCUTION</b><br/>bordereau d'ordres")
    A1 -->|mandate| A2
    A2 -->|research| A3
    A3 -->|portfolio| A4
    A4 ==>|"risk_report = PASS"| A5
    A4 -.->|"AJUSTER - corriger<br/>3 itérations au maximum"| A3
  end

  SRC("<b>SOURCES DE MARCHÉ</b><br/>yfinance · FMP<br/>SEC EDGAR · Tavily")
  STOP("<b>FAIL</b><br/>aucun ordre n'est préparé")
  QUANT("<b>MOTEUR QUANTITATIF</b> - quant/<br/>backtest 10 ans · validation hors échantillon<br/>walk-forward · bootstrap 1000× · Monte Carlo 2000×<br/>stress tests · conformité au mandat<br/><i>100 % Python - seedé, reproductible</i>")
  OK("<b>VALIDATION HUMAINE</b><br/>le fichier d'ordres n'est écrit<br/>qu'après l'approbation du gérant")

  GERANT -->|définit le mandat| WEB
  WEB -->|lance le run| A1
  A2 -->|"10 requêtes par titre<br/>5 titres en parallèle"| SRC
  A4 -->|tout le calcul| QUANT
  A4 -.->|FAIL| STOP
  A5 --> OK

  classDef juge fill:#FCF3E4,stroke:#B8801F,stroke-width:1.8px,color:#4A3208,rx:8,ry:8;
  classDef calc fill:#DAEEE8,stroke:#0D6B59,stroke-width:2.4px,color:#0A362E,rx:8,ry:8;
  classDef io fill:#EBF1FA,stroke:#3A5A8C,stroke-width:1.8px,color:#16253C,rx:8,ry:8;
  classDef stop fill:#FBE4E1,stroke:#9C2A22,stroke-width:2.4px,color:#4A110D,rx:8,ry:8;
  classDef data fill:#FFFFFF,stroke:#8496AC,stroke-width:1.4px,color:#101720,rx:8,ry:8;

  class A1,A2,A3,A5 juge;
  class A4,QUANT calc;
  class GERANT,WEB,OK io;
  class STOP stop;
  class SRC data;

  linkStyle default stroke-width:1.6px;
